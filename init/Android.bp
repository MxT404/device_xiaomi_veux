cc_library {
    name: "libinit_veux",
    vendor: true,
    srcs: ["init_veux.cpp"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    shared_libs: [
        "libbase",
        "libinit",
        "liblog",
    ],
    target: {
        android: {
            cflags: ["-DANDROID"],
        },
    },
}