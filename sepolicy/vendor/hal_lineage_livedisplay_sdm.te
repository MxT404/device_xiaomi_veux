hal_attribute(lineage_livedisplay)
type hal_lineage_livedisplay_service, hal_service_type, service_manager_type;
hal_attribute_service(hal_lineage_livedisplay, hal_lineage_livedisplay_service)

type hal_lineage_livedisplay_sdm, domain;
type hal_lineage_livedisplay_sdm_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lineage_livedisplay_sdm)
hal_server_domain(hal_lineage_livedisplay_sdm, hal_lineage_livedisplay)
binder_use(hal_lineage_livedisplay_sdm)
vndbinder_use(hal_lineage_livedisplay_sdm)
allow hal_lineage_livedisplay_sdm vendor_qdisplay_service:service_manager find;
binder_call(hal_lineage_livedisplay_sdm, hal_graphics_composer_default)
get_prop(hal_lineage_livedisplay_sdm, vendor_display_prop)
